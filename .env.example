# Supabase project — Postgres, Auth, and the reservation guarantee.
# A fresh clone runs from this file alone (PLAN.md, Layer 0 definition of done).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
# This is what makes the reservation path server-owned: the browser can never
# call reserve() directly, and there is no INSERT policy on `appointments`
# for any role.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
